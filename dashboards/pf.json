{
  "title": "pf_exporter",
  "uid": "pf-exporter",
  "tags": ["pf", "openbsd", "firewall"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Firewall",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(pf_enabled, instance)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firewall",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "pf_enabled{instance=\"$instance\"}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "disabled", "color": "red", "index": 1 },
                "1": { "text": "enabled", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "States",
      "description": "Current entries in the pf state table.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "pf_state_total{instance=\"$instance\"}",
          "legendFormat": "states"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "State churn",
      "description": "State inserts and removals per second. A sustained gap between them means the table is growing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pf_state_inserts_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "inserts"
        },
        {
          "refId": "B",
          "expr": "rate(pf_state_removals_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "removals"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Packets in, passed vs blocked",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pf_ipv4_packets_in_passed_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "IPv4 passed"
        },
        {
          "refId": "B",
          "expr": "rate(pf_ipv4_packets_in_blocked_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "IPv4 blocked"
        },
        {
          "refId": "C",
          "expr": "rate(pf_ipv6_packets_in_passed_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "IPv6 passed"
        },
        {
          "refId": "D",
          "expr": "rate(pf_ipv6_packets_in_blocked_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "IPv6 blocked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput on the log interface",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pf_ipv4_bytes_in_total{instance=\"$instance\"}[$__rate_interval]) + rate(pf_ipv6_bytes_in_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(pf_ipv4_bytes_out_total{instance=\"$instance\"}[$__rate_interval]) + rate(pf_ipv6_bytes_out_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Table size",
      "description": "Addresses held in each pf table.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pf_table_addresses{instance=\"$instance\"} > 0)",
          "legendFormat": "{{table}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "valueMode": "text",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "continuous-BlPu" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Table matches",
      "description": "Packets matching each table per second. A table with a flat line is holding addresses nothing is hitting.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pf_table_matches_total{instance=\"$instance\"}[$__rate_interval]) > 0",
          "legendFormat": "{{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Busiest rules",
      "description": "Rules ranked by the states they currently hold.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pf_rule_states_current{instance=\"$instance\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "af": true,
              "anchor": true
            },
            "renameByName": {
              "Value": "states",
              "nr": "#",
              "rule": "rule",
              "action": "action",
              "direction": "dir",
              "interface": "if",
              "proto": "proto"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "states", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rule evaluations",
      "description": "Evaluations per second for the ten busiest rules.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pf_rule_evaluations_total{instance=\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{nr}} {{action}} {{direction}} {{interface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue drops",
      "description": "Bytes dropped per queue. Empty unless queueing is configured.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pf_stats_queue_dropped_bytes_total{instance=\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{queue}} on {{interface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
